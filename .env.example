# AIChatWave — environment template.
#
#   cp .env.example .env
#
# Fill in DATABASE_URL, the two Clerk keys, OPENAI_API_KEY, and the two POLAR_*
# values and the app boots. Everything else is optional and each entry below
# says what it unlocks. Never commit the resulting .env — only this file is
# tracked, and only because it holds placeholders.

# ─── Database ────────────────────────────────────────────────────────────────
# Postgres with the pgvector extension. Used by Drizzle, the LangGraph
# checkpointer, and the long-term memory vector store.
#
# The driver is chosen from the host: `*.neon.tech` gets Neon's serverless
# (WebSocket) pool, anything else gets `pg` over plain TCP. So the compose
# service in docker-compose.yaml works with no extra configuration.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ─── Authentication (Clerk) ──────────────────────────────────────────────────
# From https://dashboard.clerk.com → API keys.
# Sign-in methods (email/password, Google, GitHub, …) are configured in the
# Clerk dashboard, not here — this app holds no OAuth client secrets.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Keep users on this app's own branded auth screens instead of Clerk's
# hosted *.accounts.dev portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional until a webhook endpoint exists. Required for Clerk → database user
# sync; without it /api/webhooks/clerk returns 503.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# ─── AI providers ────────────────────────────────────────────────────────────
# Only OpenAI is required. The other providers serve their own models and
# nothing else, so a deployment without their keys still boots — those models
# just become unavailable and return a typed 503 if selected.
#
# REQUIRED. Powers the default model (gpt-5-nano), the gpt-5-* models, memory
# extraction, and the pgvector embeddings. The app refuses to boot without it.
OPENAI_API_KEY=sk-xxx

# Optional. Unlocks gemini-3.1-pro.
# GOOGLE_API_KEY=xxx

# Optional. Unlocks claude-sonnet-4-20250514.
# ANTHROPIC_API_KEY=sk-ant-xxx

# ─── Tools ───────────────────────────────────────────────────────────────────
# Optional. Backs the display_products tool (Google Shopping via SerpAPI).
# Without it that tool is not offered to the model at all, rather than being
# offered and failing on every call. Weather and news need no key.
# SERP_API_KEY=xxx

# ─── Billing (Polar) ─────────────────────────────────────────────────────────
# Sandbox and production are two entirely separate Polar systems: separate
# dashboards, separate tokens, separate product ids. A token from one returns
# 401 invalid_token against the other, which surfaces as a failed checkout.
#
#   sandbox     dashboard https://sandbox.polar.sh   API sandbox-api.polar.sh
#   production  dashboard https://polar.sh           API api.polar.sh
#
# Running POLAR_SERVER=sandbox against a live deployment is supported and is a
# normal pre-launch setup — but sandbox takes test cards only and moves no real
# money. Switch to production when you intend to actually charge people.
#
# Required explicitly when NODE_ENV=production: defaulting it would risk
# sending production credentials to the sandbox API.
POLAR_SERVER=sandbox

# Issue this in the dashboard for the environment named above.
POLAR_ACCESS_TOKEN=polar_oat_xxx
# Must exist, and not be archived, in that same environment.
POLAR_PRODUCT_ID=00000000-0000-0000-0000-000000000000

# Optional until a Polar webhook endpoint exists, and environment-specific like
# everything else here: create the endpoint in the SAME dashboard as the token
# above (sandbox.polar.sh for POLAR_SERVER=sandbox) pointing at
# https://<your-app>/api/webhooks/polar, subscribe it to the subscription.*
# events, and paste its signing secret here. A secret from the other
# environment fails every signature check.
#
# What it buys: plan changes take effect on the next message instead of on the
# next cache refresh. Without it the local subscription mirror is filled only
# by a one-time read per user and re-verified once a day, so a fresh upgrade
# can take up to 24h to unlock Pro models. Never required to boot.
# POLAR_WEBHOOK_SECRET=polar_whs_xxx

# Verify all three at any time with: pnpm polar:doctor

# ─── App ─────────────────────────────────────────────────────────────────────
# Absolute origin, used for metadata, Polar checkout/portal return URLs, the
# cross-origin check on the API, and Clerk's authorized-parties list.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Operations ──────────────────────────────────────────────────────────────
# Comma-separated Clerk user ids allowed to open /admin/operations (spend per
# user/model/day, and standing against the service objectives) and the
# /api/admin/* routes behind it.
#
# Unset means NOBODY, not everybody — a deployment that forgets this has no
# dashboard, which is recoverable; the other reading is every user's spend
# visible to every user. Non-admins get a 404, not a 403, so the surface is not
# advertised to a stranger.
# ADMIN_USER_IDS=user_2abc...,user_2def...

# ─── Observability ───────────────────────────────────────────────────────────
# All optional. Absent, the app emits exactly the structured logs it always
# has: the OpenTelemetry API resolves to a no-op tracer when no SDK is
# registered, so the instrumentation in the code costs nothing and there is no
# feature flag to forget.
#
# Set an OTLP endpoint to start the SDK and send route → graph → LLM → tool
# spans there. On Vercel leave it unset: the platform supplies the exporter and
# the SDK starts on its own. A local collector is the usual value here —
# https://github.com/vercel/opentelemetry-collector-dev-setup
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=aichatwave
# The standard kill switch: "true" disables tracing without a code change.
# OTEL_SDK_DISABLED=false

# Optional webhook for incidents. The primary destination for an exception is
# the active trace span, where it is already correlated with the request id,
# the user and the model; this is the escape hatch for a deployment with no
# tracing backend. 4xx responses are never reported — they are the API
# answering, and paging on them is how an alert channel gets muted.
# ERROR_WEBHOOK_URL=https://hooks.example.com/incidents

# LangSmith tracing for the agent graph: prompts, tool calls and responses,
# with this app's request/user/thread ids attached as run metadata.
#
# Read note before enabling: turning this on sends conversation content to
# LangSmith. That is the point of it during an incident, and it is a decision
# about where user conversations may be stored — which is why it is off by
# default. Tracing on without a key fails at boot rather than silently sending
# nothing.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_xxx
# LANGSMITH_PROJECT=aichatwave
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Check the whole observability configuration at any time with:
#   pnpm phase-h:verify

# ─── Security ────────────────────────────────────────────────────────────────
# Optional. Set to "true" to send Content-Security-Policy-Report-Only instead
# of enforcing the policy — useful for one deploy when rolling the CSP out to a
# new environment, so violations appear in the browser console without breaking
# the page. Leave unset (enforcing) everywhere else.
# CSP_REPORT_ONLY=true
