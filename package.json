{
  "name": "aichatwave",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production next build",
    "bundle:analyze": "next experimental-analyze --output",
    "bundle:check": "node --import tsx scripts/check-bundle-budget.ts",
    "db:migrate": "pnpm migration:migrate",
    "db:reset": "node --env-file-if-exists=.env --import tsx scripts/db-reset.ts",
    "db:setup:langgraph": "node --env-file-if-exists=.env --import tsx scripts/db-setup-langgraph.ts",
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "migration:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "migration:migrate": "drizzle-kit migrate --config=drizzle.config.ts && pnpm db:setup:langgraph",
    "phase-f:verify": "node --env-file-if-exists=.env --import tsx scripts/verify-phase-f.ts",
    "phase-g:verify": "node --env-file-if-exists=.env --import tsx scripts/verify-phase-g.ts",
    "phase-h:verify": "node --env-file-if-exists=.env --import tsx scripts/verify-phase-h.ts",
    "polar:doctor": "node --env-file-if-exists=.env --import tsx scripts/polar-doctor.ts",
    "start": "next start",
    "test": "node --import tsx --test tests/**/*.test.{ts,tsx}",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/langchain": "^3.0.11",
    "@ai-sdk/react": "^4.0.12",
    "@clerk/nextjs": "^7.9.1",
    "@clerk/ui": "^1.32.2",
    "@langchain/anthropic": "^1.3.25",
    "@langchain/core": "^1.1.34",
    "@langchain/google-genai": "^2.1.26",
    "@langchain/langgraph": "^1.2.3",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.1",
    "@langchain/openai": "^1.3.0",
    "@neondatabase/serverless": "^1.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@polar-sh/sdk": "^0.46.7",
    "@streamdown/cjk": "^1.0.2",
    "@streamdown/code": "^1.0.3",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.95.0",
    "@vercel/functions": "^3.4.3",
    "@vercel/otel": "^2.1.3",
    "ai": "^7.0.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "langchain": "^1.2.36",
    "lucide-react": "^0.575.0",
    "nanoid": "^5.1.16",
    "next": "16.3.3",
    "openai": "^6.34.0",
    "pg": "^8.18.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "serpapi": "^2.2.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.3.0",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.38.0",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.8.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-73wf-gq98-2v4g",
        "GHSA-c83g-rgw3-j3cx",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-8cpq-38p9-67gx",
        "GHSA-pv5w-4p9q-p3v2",
        "GHSA-wmrf-hv6w-mr66",
        "GHSA-3644-q5cj-c5c7",
        "GHSA-r5fr-rjxr-66jc",
        "GHSA-c2c7-rcm5-vvqj"
      ]
    }
  }
}
